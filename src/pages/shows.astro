---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { showDateFormatter } from "../lib/show-dates";
import { getShows } from "../lib/bandsintown";

// Dates come from Bandsintown at request time rather than at build time, so
// adding a show there puts it on the site without a redeploy. The CDN holds
// the rendered page for 15 minutes and refreshes it in the background, which
// keeps this as cheap to serve as the static pages around it.
export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=900, stale-while-revalidate=3600"
);

const site = await getEntry("site", "settings");
if (!site) throw new Error("site.json settings entry is missing");
const copy = site.data.showsPage;

// Bandsintown holds the band's whole history — nearly 300 dates back to 2019 —
// and the past tab is there as proof they play constantly, not as an archive.
// Only the most recent stretch is rendered; the rest stay a click away on
// Bandsintown itself.
const PAST_SHOWN = 12;

const shows = await getShows();
const upcoming = shows.ok ? shows.upcoming : [];
const past = shows.ok ? shows.past.slice(0, PAST_SHOWN) : [];
const pastTotal = shows.ok ? shows.past.length : 0;

const dateFmt = showDateFormatter({ weekday: "short", month: "short", day: "numeric" });
const timeFmt = showDateFormatter({ hour: "numeric", minute: "2-digit" });

// A failed feed is not the same as an empty calendar, and saying "no shows"
// when the truth is "we could not reach Bandsintown" would be a lie.
const emptyUpcoming = shows.ok ? copy.emptyUpcoming : "Dates are temporarily unavailable — check back shortly.";
const emptyPast = shows.ok ? copy.emptyPast : "Dates are temporarily unavailable — check back shortly.";
---
<Layout title="Shows">
  <div class="mx-auto max-w-content px-[5vw] pt-[72px] pb-[110px]">
    <div class="h-1 w-[120px] bg-red mb-6"></div>
    <h1 class="font-display uppercase text-[clamp(40px,7vw,84px)] leading-[0.9] tracking-[-0.03em] m-0">Shows</h1>

    <!--
      Upcoming / Past dates tabs — pure CSS, no JavaScript. Two radio inputs
      (visually hidden) drive which panel is visible via the peer-checked
      variant; both panels are direct siblings of the inputs so the sibling
      selector applies.
    -->
    <div class="mt-8 flex flex-wrap gap-6">
      <input type="radio" id="tab-upcoming" name="show-tab" class="peer/upcoming hidden" checked />
      <input type="radio" id="tab-past" name="show-tab" class="peer/past hidden" />

      <label
        for="tab-upcoming"
        class="cursor-pointer pb-1.5 border-b-2 border-transparent font-mono text-[11px] tracking-[0.18em] uppercase text-ink-muted peer-checked/upcoming:text-white peer-checked/upcoming:border-red"
      >
        Upcoming
      </label>
      <label
        for="tab-past"
        class="cursor-pointer pb-1.5 border-b-2 border-transparent font-mono text-[11px] tracking-[0.18em] uppercase text-ink-muted peer-checked/past:text-white peer-checked/past:border-red"
      >
        Past dates
      </label>

      <div class="hidden peer-checked/upcoming:block basis-full border border-line mt-2">
        {upcoming.length === 0 && (
          <p class="p-6 text-ink-muted text-sm">{emptyUpcoming}</p>
        )}
        {upcoming.map((show) => (
          <div class="grid gap-4 md:gap-6 items-center px-6 py-5.5 border-b border-line" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
            <div class="max-w-[180px]">
              <div class="font-condensed font-bold text-sm tracking-[0.14em] uppercase text-red">{dateFmt.format(show.date)}</div>
              <div class="font-mono text-[11px] text-ink-dim mt-1">{timeFmt.format(show.date)}</div>
            </div>
            <div class="min-w-0">
              <div class="font-condensed font-semibold text-[22px] uppercase tracking-[0.04em] leading-tight">{show.venue}</div>
              <a
                href={show.directionsUrl}
                target="_blank"
                rel="noopener"
                aria-label={`Get directions to ${show.venue}`}
                class="inline-block text-sm text-ink-muted mt-1 border-b border-line-strong hover:text-white hover:border-red transition-colors"
              >
                {show.address}
              </a>
            </div>
            <div class="flex gap-2.5 flex-wrap justify-start">
              <a
                href={show.ticketUrl ?? show.eventUrl}
                target="_blank"
                rel="noopener"
                class="font-condensed font-bold text-[13px] tracking-[0.12em] uppercase text-white bg-red px-[22px] py-[13px] hover:bg-red-hover transition-colors"
              >
                {show.ticketUrl ? "Tickets" : "RSVP"}
              </a>
            </div>
          </div>
        ))}
        <div class="px-6 py-5.5 flex flex-wrap gap-4 items-center justify-between">
          <span class="text-[15px] text-ink-muted">{copy.bookingPrompt}</span>
          <a href="/bookings" class="font-condensed font-bold text-sm tracking-[0.12em] uppercase text-ink border border-line-strong px-6 py-3.5 hover:text-white hover:border-red transition-colors">{copy.bookingCta}</a>
        </div>
      </div>

      <div class="hidden peer-checked/past:block basis-full border border-line mt-2">
        {past.length === 0 && (
          <p class="p-6 text-ink-muted text-sm">{emptyPast}</p>
        )}
        {past.map((show) => (
          <div class="grid gap-4 md:gap-6 items-center px-6 py-5.5 border-b border-line opacity-60" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
            <div class="max-w-[180px]">
              <div class="font-condensed font-bold text-sm tracking-[0.14em] uppercase text-ink-muted">{dateFmt.format(show.date)}</div>
              <div class="font-mono text-[11px] text-ink-dim mt-1">{timeFmt.format(show.date)}</div>
            </div>
            <div class="min-w-0">
              <div class="font-condensed font-semibold text-[22px] uppercase tracking-[0.04em] leading-tight">{show.venue}</div>
              {/* Not a link here: directions to a show that already happened are noise. */}
              <div class="text-sm text-ink-muted mt-1">{show.address}</div>
            </div>
            <span class="font-mono text-[11px] tracking-[0.14em] text-ink-dim">PLAYED</span>
          </div>
        ))}
        {pastTotal > PAST_SHOWN && (
          <div class="px-6 py-5 border-b border-line">
            <a
              href="https://www.bandsintown.com/a/15393148?tab=past_dates"
              target="_blank"
              rel="noopener"
              class="font-mono text-[11px] tracking-[0.16em] uppercase"
            >
              See all {pastTotal} dates we've played →
            </a>
          </div>
        )}
        <div class="px-6 py-5.5 flex flex-wrap gap-4 items-center justify-between">
          <span class="text-[15px] text-ink-muted">{copy.bookingPrompt}</span>
          <a href="/bookings" class="font-condensed font-bold text-sm tracking-[0.12em] uppercase text-ink border border-line-strong px-6 py-3.5 hover:text-white hover:border-red transition-colors">{copy.bookingCta}</a>
        </div>
      </div>
    </div>

    <p class="mt-6 font-mono text-[11px] tracking-[0.14em] uppercase text-ink-dim">
      Dates powered by <a href="https://www.bandsintown.com/a/15393148" target="_blank" rel="noopener">Bandsintown</a>
    </p>
  </div>
</Layout>
