---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const members = (await getCollection("band")).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="The Band">
  <div class="mx-auto max-w-content px-[5vw] pt-[72px] pb-[110px]">
    <div class="h-1 w-[120px] bg-red mb-6"></div>
    <h1 class="font-display uppercase text-[clamp(40px,7vw,84px)] leading-[0.9] tracking-[-0.03em] m-0">The band</h1>
    <p class="text-[clamp(18px,2.2vw,24px)] text-ink-soft max-w-[640px] mt-5 leading-snug">Five South Florida musicians who have been playing these rooms long enough to read them. Rock, alt and pop covers, played loud and played right.</p>
    <div class="grid gap-5 mt-12 items-start" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      {members.map((member) => (
        <div>
          <div class="relative aspect-[4/5] placeholder-bg border border-line flex items-end p-3">
            {member.data.portrait && (
              <img src={member.data.portrait} alt={member.data.name} class="absolute inset-0 w-full h-full object-cover" />
            )}
            <span class="relative font-mono text-[10px] tracking-[0.14em] text-ink-dimmer">PORTRAIT 4:5</span>
          </div>
          <div class="font-condensed font-semibold text-xl uppercase tracking-[0.04em] mt-3.5">{member.data.name}</div>
          <div class="font-mono text-[11px] tracking-[0.16em] text-red mt-1.5">{member.data.role}</div>
        </div>
      ))}
    </div>
  </div>
</Layout>
