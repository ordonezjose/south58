---
import Layout from "../layouts/Layout.astro";
import BackgroundMedia from "../components/BackgroundMedia.astro";
import FeaturedVideo from "../components/FeaturedVideo.astro";
import { hasMedia } from "../lib/background-media";
import { showDateFormatter, startOfToday } from "../lib/show-dates";
import { getCollection, getEntry } from "astro:content";

const site = await getEntry("site", "settings");
if (!site) throw new Error("site.json settings entry is missing");

const allShows = await getCollection("shows");
const today = startOfToday();
const nextShows = allShows
  .filter((s) => s.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order
);

const monthFmt = showDateFormatter({ month: "short" });

const heroMedia = site.data.home.heroMedia;
const whoWeAreMedia = site.data.home.whoWeAreMedia;
---
<Layout title="Home">
  <!-- HERO -->
  <section class="relative min-h-[min(92vh,820px)] flex flex-col justify-end px-[5vw] pt-[120px] pb-[124px] overflow-hidden">
    <BackgroundMedia media={heroMedia} />
    <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/20 to-black/95"></div>
    <div class="relative w-full mx-auto max-w-content">
      <div class="h-1 w-[180px] bg-red mb-6"></div>
      <h1 class="font-display uppercase text-[clamp(64px,13vw,150px)] leading-[0.84] tracking-[-0.04em] m-0">
        {site.data.home.heroLine1}<br />{site.data.home.heroLine2.replace(/\.$/, "")}<span class="text-red">.</span>
      </h1>
      <div class="flex flex-wrap items-end justify-between gap-7 mt-7">
        <p class="m-0 text-[clamp(16px,2vw,19px)] leading-relaxed text-ink-soft max-w-[440px]">
          {site.data.home.heroSubcopy}
        </p>
        {!hasMedia(heroMedia) && (
          <span class="font-mono text-[10px] tracking-[0.2em] text-ink-dimmer">[ FULL-BLEED LOOPED LIVE VIDEO ]</span>
        )}
      </div>
    </div>
  </section>

  <section class="px-[5vw] pb-24 -mt-[70px] relative">
    <div class="mx-auto max-w-content">

      <!-- ON THE ROAD -->
      <div class="bg-surface border border-line-strong p-7">
        <div class="flex items-baseline justify-between gap-4 mb-5.5">
          <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-red">ON THE ROAD</span>
          <a href="/shows" class="font-mono text-[11px] tracking-[0.16em] uppercase text-ink hover:text-red-hover transition-colors">All dates →</a>
        </div>
        <div class="grid gap-px bg-line-strong" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));">
          {nextShows.length === 0 && (
            <div class="bg-surface p-6 text-ink-muted text-sm">No shows on the books yet — check back soon.</div>
          )}
          {nextShows.map((show) => (
            <div class="bg-surface px-[22px] py-6 flex flex-col gap-2.5">
              <div class="font-display text-[32px] leading-none">
                {show.data.date.getUTCDate()}<span class="text-[15px] text-red ml-2">{monthFmt.format(show.data.date).toUpperCase()}</span>
              </div>
              <div class="font-condensed font-semibold text-xl uppercase tracking-[0.04em] leading-tight">{show.data.venue}</div>
              <div class="text-sm text-ink-muted">{show.data.city} · {show.data.time}</div>
              <a href="/bookings" class="font-condensed font-bold text-[13px] tracking-[0.12em] uppercase text-white mt-1.5 hover:text-red-hover transition-colors">RSVP →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- WHO WE ARE -->
      <div class="relative mt-16 min-h-[400px] border border-line flex items-end overflow-hidden">
        <BackgroundMedia media={whoWeAreMedia} />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/55 to-black/25"></div>
        <div class="relative px-10 py-12">
          <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-red">WHO WE ARE</span>
          <p class="text-[clamp(20px,2.4vw,26px)] leading-[1.45] mt-4.5 max-w-[520px]">{site.data.home.whoWeAreCopy}</p>
          <a href="/band" class="inline-block mt-6 font-condensed font-bold text-sm tracking-[0.12em] uppercase border-b border-red pb-0.5 hover:text-white transition-colors">Meet the band</a>
        </div>
        {!hasMedia(whoWeAreMedia) && (
          <span class="absolute top-4 right-[18px] font-mono text-[10px] tracking-[0.16em] text-ink-dimmer">BACKGROUND IMAGE — FULL ROW</span>
        )}
      </div>

      <!-- FEATURED VIDEO + BOOK US -->
      <div class="grid gap-5 mt-[72px] items-start" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <FeaturedVideo url={site.data.home.featuredVideoUrl} class="aspect-video col-span-2 min-w-0" />
        <div class="bg-raised border border-line p-7 flex flex-col gap-4">
          <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-red">BOOK US</span>
          <p class="m-0 font-condensed font-bold text-[clamp(26px,3vw,34px)] leading-[1.05] uppercase">{site.data.home.bookUsCopy}</p>
          <a href="/bookings" class="block text-center font-condensed font-bold text-[15px] tracking-[0.12em] uppercase text-white bg-red px-7 py-4 mt-auto hover:bg-red-hover transition-colors">Start a booking</a>
          <span class="font-mono text-[11px] tracking-[0.12em] text-ink-dim">{site.data.email.toUpperCase()}</span>
        </div>
      </div>

      <!-- WHAT PEOPLE SAY -->
      <div class="mt-20">
        <div class="flex items-baseline justify-between gap-4 mb-6.5">
          <h2 class="font-display uppercase text-[clamp(26px,3.4vw,40px)] tracking-[-0.01em] m-0">WHAT PEOPLE SAY</h2>
        </div>
        <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
          {testimonials.map((t) => (
            <div class="bg-raised border border-line p-7 flex flex-col gap-3.5">
              <div class="font-display text-3xl text-red leading-none">&ldquo;</div>
              <p class="m-0 text-lg leading-relaxed">{t.data.quote}</p>
              <div class="font-mono text-[11px] tracking-[0.14em] text-ink-dim">{t.data.source}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Parallax: a background drifts against its section instead of sitting
  // still, so it reads as further away.
  //
  // The layer is scaled up, and its drift is mapped onto exactly the overhang
  // that scaling buys — spread across the section's whole trip through the
  // viewport. Because the shift can never exceed the overhang, the layer is
  // guaranteed to still cover its section at every scroll position, whatever
  // the section's height or position on the page.
  const layers = document.querySelectorAll<HTMLElement>("[data-parallax]");

  if (layers.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const SCALE = 1.25;
    const OVERHANG = (SCALE - 1) / 2; // as a fraction of section height, per edge
    let queued = false;

    const render = () => {
      queued = false;

      for (const layer of layers) {
        const section = layer.parentElement;
        if (!section) continue;

        const box = section.getBoundingClientRect();
        if (box.bottom <= 0 || box.top >= innerHeight) continue;

        // -1 as the section enters from the bottom, +1 as it leaves the top.
        const travel = (innerHeight + box.height) / 2;
        const progress = (innerHeight / 2 - (box.top + box.height / 2)) / travel;
        const shift = progress * box.height * OVERHANG;

        layer.style.transform = `translate3d(0, ${shift}px, 0) scale(${SCALE})`;
      }
    };

    for (const layer of layers) layer.style.willChange = "transform";
    render();

    addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(render);
        }
      },
      { passive: true }
    );
    addEventListener("resize", render, { passive: true });
  }
</script>
