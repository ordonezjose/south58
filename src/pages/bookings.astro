---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const site = await getEntry("site", "settings");
if (!site) throw new Error("site.json settings entry is missing");

// Point this at a form service (Formspree, Web3Forms) or a Vercel Function to
// turn the form on — see the README. Until it is set the page falls back to a
// note telling visitors how to reach the band: whoever lands here is a venue
// trying to book them, not someone who needs to hear which setting is missing.
const formAction = import.meta.env.PUBLIC_BOOKING_FORM_ACTION;

const fieldClass =
  "bg-raised border border-line-strong text-ink font-sans text-base px-4 py-3.5 outline-none transition-colors focus:border-red min-w-0";
const labelClass = "font-condensed font-semibold text-[13px] tracking-[0.14em] uppercase text-ink-muted";
---
<Layout title="Bookings">
  <div class="mx-auto max-w-content px-[5vw] pt-[72px] pb-[110px]">
    <div class="grid gap-14 items-start" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
      <div>
        <div class="h-1 w-[120px] bg-red mb-6"></div>
        <h1 class="font-display uppercase text-[clamp(40px,6vw,72px)] leading-[0.9] tracking-[-0.03em] m-0">Bookings</h1>
        <p class="text-[clamp(18px,2.2vw,22px)] text-ink-soft mt-5.5 leading-snug max-w-[460px]">{site.data.bookings.intro}</p>
        <div class="mt-9 flex flex-col gap-4.5 font-mono text-xs tracking-[0.14em] text-ink-muted">
          <div><span class="text-red">EMAIL</span> · <a href={`mailto:${site.data.email}`}>{site.data.email}</a></div>
          <div><span class="text-red">PHONE</span> · {site.data.phone}</div>
          <div><span class="text-red">BASED IN</span> · {site.data.location}</div>
        </div>
      </div>

      {formAction ? (
        <Fragment>
        <form
          id="booking-form"
          method="POST"
          action={formAction}
          class="grid gap-5"
          style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));"
        >
          {/* Formspree reads `subject` for the notification's subject line and
              takes the reply-to from the field named `email`. */}
          <input type="hidden" name="subject" value={`Booking request — ${site.data.bandName}`} />
          {/* Honeypot: Formspree drops anything that fills `_gotcha`. It has to
              be a visible input type hidden with CSS — a type="hidden" input is
              skipped by most bots, which defeats the trap. */}
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />
          <label class="flex flex-col gap-2">
            <span class={labelClass}>Your name</span>
            <input type="text" name="name" placeholder="Jane Doe" required class={fieldClass} />
          </label>
          <label class="flex flex-col gap-2">
            <span class={labelClass}>Email</span>
            <input type="email" name="email" placeholder="you@venue.com" required class={fieldClass} />
          </label>
          <label class="flex flex-col gap-2">
            <span class={labelClass}>Phone</span>
            <input type="tel" name="phone" placeholder="786-000-0000" class={fieldClass} />
          </label>
          <label class="flex flex-col gap-2">
            <span class={labelClass}>Event date</span>
            <input type="text" name="date" placeholder="MM / DD / YYYY" class={fieldClass} />
          </label>
          <label class="flex flex-col gap-2 col-span-full">
            <span class={labelClass}>Tell us about the event</span>
            <textarea name="details" rows="5" placeholder="Venue, city, set length, budget range" class:list={[fieldClass, "resize-y"]}></textarea>
          </label>
          <label class="flex flex-col gap-2 col-span-full">
            <span class={labelClass}>How did you hear about {site.data.bandName}?</span>
            <input type="text" name="source" placeholder="Saw us live, referral, Instagram…" class={fieldClass} />
          </label>
          <div class="col-span-full flex flex-wrap gap-3.5 items-center">
            <button type="submit" class="font-condensed font-bold text-[15px] tracking-[0.12em] uppercase text-white bg-red border-0 px-8 py-4 cursor-pointer hover:bg-red-hover transition-colors disabled:opacity-60 disabled:cursor-wait">Send request</button>
            <span class="text-[13px] text-ink-dim">{site.data.bookings.formNote}</span>
          </div>
          <p data-form-error hidden class="col-span-full m-0 text-[15px] text-red-hover leading-relaxed">
            That didn't go through. Please try again, or email us at{" "}
            <a href={`mailto:${site.data.email}`}>{site.data.email}</a>.
          </p>
        </form>

        <div data-form-sent hidden class="bg-surface border border-line p-7">
          <div class="h-1 w-[60px] bg-red mb-5"></div>
          <p class="m-0 text-[17px] text-ink-soft leading-relaxed">{site.data.bookings.confirmation}</p>
        </div>
        </Fragment>
      ) : (
        <div class="bg-surface border border-line p-7">
          <p class="m-0 text-ink-muted leading-relaxed">
            Our booking form is on its way. In the meantime, send us the date, the venue and
            what you have in mind — we'll take it from there.
          </p>
          <a href={`mailto:${site.data.email}`} class="inline-block mt-5 font-condensed font-bold text-[15px] tracking-[0.12em] uppercase text-white bg-red px-8 py-4 hover:bg-red-hover transition-colors">Email us</a>
          <div class="mt-5 font-mono text-[11px] tracking-[0.14em] text-ink-dim">
            Or call {site.data.phone}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Submitting straight to Formspree would land the visitor on Formspree's own
  // confirmation page — sending a venue off the site mid-enquiry — and keeping
  // them here by redirecting back is a paid feature. Posting it from here
  // instead keeps them on the page. Without JavaScript the form still submits
  // normally, so the request always gets through.
  const form = document.querySelector<HTMLFormElement>("#booking-form");
  const sent = document.querySelector<HTMLElement>("[data-form-sent]");
  const failure = document.querySelector<HTMLElement>("[data-form-error]");

  if (form && sent && failure) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const label = button?.textContent ?? "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      failure.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = "Sending…";
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          // Formspree answers with JSON instead of a redirect when asked to.
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.hidden = true;
        sent.hidden = false;
        sent.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        // The message carries the email address, so a failure here still
        // leaves the visitor with a way to reach the band.
        failure.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      }
    });
  }
</script>
