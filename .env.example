# Copy this file to .env (local dev) and set the same keys in the Vercel
# project's Environment Variables (production). All are optional — the site
# builds and runs fine without any of them, just with analytics/the booking
# form switched off.

# Umami analytics. Get these from your Umami instance (self-hosted or
# cloud.umami.is): Settings -> Websites -> your site -> Tracking code.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=

# Bandsintown API key for the tour dates on / and /shows. Generate it in
# Bandsintown for Artists -> Settings -> General -> "Get API Key". The key is
# tied to the SOUTH58 artist profile and only returns that artist's events, so
# it cannot be shared or reused. Server-side only — deliberately no PUBLIC_
# prefix, since exposing it to the browser would breach Bandsintown's terms.
# Without it, both pages say dates are temporarily unavailable.
BANDSINTOWN_APP_ID=

# Booking form endpoint. Create a form at formspree.io and paste the endpoint
# it gives you — it looks like https://formspree.io/f/xxxxxxxx. The page posts
# to it from the browser, so the visitor stays on the site; without JavaScript
# the form submits the ordinary way and still reaches Formspree.
#
# PUBLIC_ on purpose: the value ends up in the form's action attribute, so it
# is public either way. Set it in the Vercel project's Environment Variables
# too, and redeploy — leaving it empty makes /bookings show the band's email
# and phone instead of a form that goes nowhere.
PUBLIC_BOOKING_FORM_ACTION=

# Keystatic on the live site. Leave all four empty and the panel keeps writing
# to the files in src/content/ and only runs under `astro dev`. Fill them in
# and it saves by committing to the GitHub repo instead, which is what lets it
# run at south58band.com/keystatic — GitHub provides the login, so only people
# with write access to the repo can edit.
#
# Don't type these by hand: run `npm run dev`, open /keystatic, click the login
# button and follow the prompts. Keystatic creates the GitHub app and writes
# all four values into .env for you. Then copy the same four into the Vercel
# project's Environment Variables and redeploy.
#
# KEYSTATIC_SECRET signs the editor's session cookie — treat it like a
# password, and never let it or the client secret near the browser (note they
# have no PUBLIC_ prefix, unlike the app slug).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
